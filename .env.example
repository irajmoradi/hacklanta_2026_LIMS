# Village configuration inventory. Placeholders only; never enter real secrets here.
# See docs/SETUP.md. Point VILLAGE_ENV_FILE at an existing private file; never copy it.
# Active defaults are safe for browser mock mode. Uncomment only the optional settings you need.
# Blank optional numeric/path settings can break defaults: leave their assignments commented.
# OS/tool built-ins (HOME, PATH, NODE_ENV, etc.) and shell locals are intentionally excluded.
# Test and tooling overrides are included for discovery, not required for service startup.

# Shared runtime and databases
# Use the same absolute artifact directory for API and CPU bridge; read by apps/api/app/config.py
# ASSET_DIR=
# Main Postgres connection; connected API, bridge and activity only; read by apps/activity/config.py
# DATABASE_URL=
# Shared API/iMessage service authentication secret; read by apps/api/app/config.py
# SERVICE_KEY=
# Optional separate TLS house database; omit to use main pool; read by apps/api/app/config.py
# TIGER_DATABASE_URL=
# Windows native Python: app.runtime:selector_loop; read by Uvicorn CLI environment option
# UVICORN_LOOP=
# Export for Vite proxy (origin); agent requires origin plus /api; read by apps/api/scripts/feat019_public_probe.py
# VILLAGE_API_URL=
# Optional override; read by apps/api/app/config.py
# VILLAGE_BUILD=
# Existing private dotenv file; process values take precedence; read by apps/activity/config.py
# VILLAGE_ENV_FILE=

# Browser and identity
# Optional override; read by apps/api/app/config.py
# AUTH0_AUDIENCE=
# Optional override; read by apps/api/app/config.py
# AUTH0_DOMAIN=
# Impersonable API demo seats; explicitly enable only when intended; read by apps/api/app/config.py
DEMO_AUTH=0
# Loopback-only debug routes; keep disabled for shared deployments; read by apps/api/app/config.py
DEMO_DEBUG=0
# Optional override; read by apps/web/src/Auth.tsx
# VITE_AUTH0_AUDIENCE=
# Optional override; read by apps/web/src/Auth.tsx
# VITE_AUTH0_CLIENT_ID=
# Optional override; read by apps/web/src/Auth.tsx
# VITE_AUTH0_DOMAIN=
# Explicit build flag; production tooling defaults 0; raw Vite enables if configured and not mock unless 0
# Read by apps/web/src/Auth.tsx and ops/deploy/prod-deploy.py
VITE_AUTH0_ENABLED=0
# Opt in to browser debug probe; does not enable server debug; read by apps/web/src/components/DemoTools.tsx
VITE_DEMO_DEBUG=0
# Browser demo seat picker; align with API for connected use; read by apps/web/src/Auth.tsx
VITE_DEMO_AUTH=1
# Optional override; read by apps/web/src/api/client.ts
# VITE_DEMO_USER=
# Browser fixture API; Lab Ask the Mayor bypasses mock (see safe proxy in SETUP); read by apps/web/src/Auth.tsx
VITE_MOCK=1

# Gemini, OpenRouter and ElevenLabs
# Private key for consented IVC and TTS; stock TTS also needs a key; read by apps/api/app/config.py
# ELEVENLABS_API_KEY=
# Export before Python imports; current source default gemini-3.5-flash-lite; read by apps/api/app/mayor.py
# GEMINI_MODEL=
# Vertex AI express key for Mayor, evidence and caller-side stylization; read by apps/api/app/config.py
# GOOGLE_API_KEY=
# Use Vertex transport for the Google key; read by apps/api/app/config.py
GOOGLE_GENAI_USE_VERTEXAI=true
# Durable hourly LLM attempt cap; zero blocks new calls; read by apps/api/app/config.py
LLM_MAX_CALLS_PER_HOUR=0
# Primary general provider; other provider is fallback; evidence uses Gemini; read by apps/api/app/config.py
LLM_PROVIDER=gemini
# Explicitly off for rehearsals; otherwise demo auth enables it by default; read by apps/api/app/config.py
MAYOR_SCHEDULER=0
# Scheduler interval in seconds; omit for default 300; read by apps/api/app/config.py
# MAYOR_TICK_SECONDS=
# Optional paid Mayor speech; off for rehearsals; read by apps/api/app/config.py
MAYOR_VOICE=0
# Optional override; read by apps/api/app/config.py
# OPENROUTER_API_KEY=
# Optional model override; source default deepseek/deepseek-v4-flash; read by apps/api/app/config.py
# OPENROUTER_MODEL=

# SEC-001 daily caps (zero blocks new operations)
# UTC elevenlabs global daily operation cap; set 0 to block; read by apps/api/app/security.py
# COST_ELEVENLABS_GLOBAL_DAILY=
# UTC elevenlabs ip daily operation cap; set 0 to block; read by apps/api/app/security.py
# COST_ELEVENLABS_IP_DAILY=
# UTC elevenlabs seat daily operation cap; set 0 to block; read by apps/api/app/security.py
# COST_ELEVENLABS_SEAT_DAILY=
# UTC gpu global daily operation cap; set 0 to block; read by apps/api/app/security.py
# COST_GPU_GLOBAL_DAILY=
# UTC gpu ip daily operation cap; set 0 to block; read by apps/api/app/security.py
# COST_GPU_IP_DAILY=
# UTC gpu seat daily operation cap; set 0 to block; read by apps/api/app/security.py
# COST_GPU_SEAT_DAILY=
# UTC llm global daily operation cap; set 0 to block; read by apps/api/app/security.py
# COST_LLM_GLOBAL_DAILY=
# UTC llm ip daily operation cap; set 0 to block; read by apps/api/app/security.py
# COST_LLM_IP_DAILY=
# UTC llm seat daily operation cap; set 0 to block; read by apps/api/app/security.py
# COST_LLM_SEAT_DAILY=
# UTC photon global daily operation cap; set 0 to block; read by apps/api/app/security.py
# COST_PHOTON_GLOBAL_DAILY=
# UTC photon ip daily operation cap; set 0 to block; read by apps/api/app/security.py
# COST_PHOTON_IP_DAILY=
# UTC photon queue global daily operation cap; set 0 to block; read by apps/api/app/security.py
# COST_PHOTON_QUEUE_GLOBAL_DAILY=
# UTC photon queue ip daily operation cap; set 0 to block; read by apps/api/app/security.py
# COST_PHOTON_QUEUE_IP_DAILY=
# UTC photon queue seat daily operation cap; set 0 to block; read by apps/api/app/security.py
# COST_PHOTON_QUEUE_SEAT_DAILY=
# UTC photon seat daily operation cap; set 0 to block; read by apps/api/app/security.py
# COST_PHOTON_SEAT_DAILY=

# GPU models, Modal and CPU bridge
# Optional override; read by workers/gpu/expr.py
# A2E_ROOT=
# Optional override; read by workers/gpu/head.py
# BLENDER=
# Optional override; read by workers/gpu/server.py
# CONDA_ENVS=
# Optional override; read by workers/gpu/face.py
# FACE_CKPT_DIR=
# Optional override; read by workers/gpu/face.py
# FACE_MATCH_THRESHOLD=
# Caller credential matching Modal secret GPU_KEY; read by apps/api/app/config.py
# GPU_FALLBACK_KEY=
# Optional existing protected key file; API and bridge defaults differ; read by apps/api/app/config.py
# GPU_FALLBACK_KEY_FILE=
# Your deployed Modal gateway URL, without trailing slash; read by apps/api/app/config.py
# GPU_FALLBACK_URL=
# Modal dashboard secret village-gpu-key only; never browser env; read by workers/modal/app.py
# GPU_KEY=
# local or modal; set modal explicitly for cloud-first routing; read by apps/api/app/config.py
# GPU_PREFER=
# Optional bridge-specific local worker base override; read by ops/run_gpu.sh
# GPU_WORKER_BASE=
# Local GPU worker endpoint; blank disables the local probe; read by apps/api/app/config.py
# GPU_WORKER_URL=
# Export before Python imports; render wait seconds, separate from delivery deadline; read by apps/api/app/gram_video.py
# GRAM_VIDEO_MODAL_WAIT_S=
# Optional override; read by workers/gpu/scripts/env.sh
# HF_HOME=
# Gated model download token; export for external env-file setups; read by workers/gpu/scripts/env.sh
# HF_TOKEN=
# Optional override; read by workers/gpu/headmesh.py
# HY3D_ROOT=
# Optional override; read by workers/gpu/head.py
# LAM_ROOT=
# Optional override; read by workers/modal/wsl_modal.sh
# MODAL_CONFIG_PATH=
# Optional override; read by workers/modal/wsl_modal.sh
# MODAL_PROFILE=
# Optional Modal SDK credential; prefer modal token new; read by external operator CLI
# MODAL_TOKEN_ID=
# Optional Modal SDK credential; prefer modal token new; read by external operator CLI
# MODAL_TOKEN_SECRET=
# Set 1 to prohibit uncached bridge stylization calls; read by workers/gpu/bridge.py
# NO_NEW_GEMINI=
# Optional override; read by workers/gpu/head.py
# NUMBA_THREADING_LAYER=
# Optional override; read by workers/gpu/stylize.py
# STYLIZE_MODEL=
# Optional override; read by workers/gpu/server.py
# TALK_KEEP_EXPR=
# Optional override; read by workers/gpu/head.py
# TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=
# Optional override; read by workers/gpu/scripts/env.sh
# VCV_ROOT=
# Optional override; read by ops/run_gpu.sh
# VILLAGE_DATA_DIR=
# Optional override; read by workers/gpu/render/serve.py
# VILLAGE_MODELS_DIR=
# Optional override; read by workers/gpu/bridge.py
# VILLAGE_REPO=
# Optional override; read by workers/gpu/scripts/smoke_test.sh
# WORKER_URL=
# Optional override; read by ops/run_gpu.sh
# WSL_DISTRO=

# Photon Spectrum
# Agent poll interval 100..60000 ms; default 15000; read by apps/imessage/src/config.ts
# OUTBOX_POLL_MS=
# Only literal true enables real sends; false still permits inbound API writes; read by apps/imessage/src/config.ts
PHOTON_SEND_ENABLED=false
# Photon project Settings identifier; read by apps/imessage/src/config.ts
# PROJECT_ID=
# Photon project Settings secret (SDK docs may call it SECRET_KEY); read by apps/imessage/src/config.ts
# PROJECT_SECRET=

# Solana devnet
# Approved v2 devnet program public address; v1 ABI is incompatible; read by apps/api/app/config.py
# SOLANA_PROGRAM_ID=
# Devnet RPC only; omit for public devnet default; read by apps/api/app/config.py
# SOLANA_RPC_URL=
# Treasury public address for verified devnet XP payments; read by apps/api/app/config.py
# SOLANA_TREASURY_ADDRESS=

# Optional activity collector
# Optional override; read by apps/activity/main.py
# DISCORD_BOT_TOKEN=
# Optional override; read by apps/activity/main.py
# STEAM_API_KEY=

