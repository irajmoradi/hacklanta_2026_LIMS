{
  "name": "village-trailer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "studio": "remotion studio src/index.tsx",
    "check": "tsc --noEmit",
    "stills": "node scripts/render.mjs stills",
    "render": "node scripts/render.mjs all",
    "verify": "python scripts/verify.py",
    "deliver": "bun run check && bun run render && bun run verify",
    "deliver:square": "bun run check && node scripts/render.mjs square && bun run verify"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  }
}
