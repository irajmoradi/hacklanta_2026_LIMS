{
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Entry"
      },
      "minItems": 1
    },
    "buildings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "placement": {
            "type": "object",
            "properties": {
              "district": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "offset": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "size": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "district",
              "offset",
              "size"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "placement"
        ],
        "additionalProperties": false
      }
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 1
          },
          "xp": {
            "type": "integer",
            "minimum": 0
          },
          "buildings": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "level",
          "xp",
          "buildings"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "districts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "origin": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "jitter": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "origin",
          "jitter"
        ],
        "additionalProperties": false
      }
    },
    "event_packs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EventPack"
      }
    }
  },
  "required": [
    "version",
    "entries",
    "buildings",
    "levels",
    "districts"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://village.local/catalog.schema.json",
  "title": "VillageCatalog",
  "$defs": {
    "Entry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "kind": {
          "enum": [
            "clothing",
            "pet",
            "house",
            "decoration",
            "voice_style",
            "building",
            "consumable",
            "farm_animal",
            "house_addon"
          ]
        },
        "slot": {
          "enum": [
            "head",
            "face",
            "torso",
            "neck",
            "pet",
            "house",
            "decoration",
            "voice_style",
            "consumable",
            "farm_animal",
            "house_addon",
            "bottoms",
            "shoes"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "price_coins": {
          "type": "integer",
          "minimum": 0
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "unlock": {
          "type": "object",
          "properties": {
            "village_level": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "village_level"
          ],
          "additionalProperties": false
        },
        "asset": {
          "type": "object",
          "properties": {
            "glb": {
              "type": "string",
              "pattern": "^/models/[a-z][a-z0-9_]*\\.glb$"
            },
            "attach": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "bone": {
                      "type": "string",
                      "minLength": 1
                    },
                    "offset": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "rotation": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "scale": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "offset",
                    "rotation",
                    "scale",
                    "bone"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "anchor": {
                      "type": "string",
                      "minLength": 1
                    },
                    "offset": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "rotation": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "scale": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "offset",
                    "rotation",
                    "scale",
                    "anchor"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "tint_materials": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "variants": {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "scale": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "materials": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    }
                  }
                },
                "required": [
                  "id",
                  "scale",
                  "materials"
                ]
              }
            }
          },
          "required": [
            "glb"
          ],
          "additionalProperties": false
        },
        "voice_style": {
          "type": "object",
          "properties": {
            "prompt": {
              "type": "string",
              "minLength": 1
            },
            "supported": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "prompt"
          ],
          "additionalProperties": false
        },
        "rarity": {
          "enum": [
            "common",
            "uncommon",
            "rare",
            "epic",
            "legendary"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "uniqueItems": true
        },
        "source": {
          "type": "string",
          "pattern": "^(shop|event:[a-z][a-z0-9_]*|earned:[a-z][a-z0-9_]*)$"
        },
        "tint": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "fit": {
          "type": "object",
          "description": "Optional generated-head fit. Offset uses head width/height/depth fractions; scale multiplies the per-slot fit.",
          "properties": {
            "generated": {
              "type": "object",
              "properties": {
                "offset": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "scale": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "minItems": 3,
                  "maxItems": 3
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "scatter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "surface": {
              "enum": [
                "ground",
                "water"
              ]
            },
            "hint": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "weight": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "clearance_m": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "surface",
            "hint",
            "weight",
            "clearance_m"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "description",
        "price_coins",
        "source",
        "rarity"
      ],
      "additionalProperties": false
    },
    "EventPack": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "pieces": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "weather": {
          "enum": [
            "clear",
            "rain",
            "fog",
            "festival_night"
          ]
        },
        "mood": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      },
      "required": [
        "id",
        "name",
        "pieces",
        "mood"
      ],
      "additionalProperties": false
    }
  }
}
